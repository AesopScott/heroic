# Unity text assets should stay reviewable and use Unity's YAML merge driver when configured locally.
*.asmdef text eol=lf
*.cginc text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.gitkeep text eol=lf
*.hlsl text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.prefab text eol=lf
*.preset text eol=lf
*.renderTexture text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadervariants text eol=lf
*.unity text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Source, docs, scripts, and WebGL template files.
.gitattributes text eol=lf
.gitignore text eol=lf
*.code-workspace text eol=lf
*.cs text eol=lf diff=csharp
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.ts text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

